                  <Ellipse Width="40" Height="40" Stroke="#2A2A4A" StrokeThickness="3" Fill="#00FFFFFF" />
                  <Ellipse Width="40" Height="40" Stroke="#7B8CFF" StrokeThickness="3" StrokeDashArray="31.4 94.2" StrokeDashCap="Round" Fill="#00FFFFFF" RenderTransformOrigin="0.5,0.5">
                    <UIElement.RenderTransform>
                      <RotateTransform x:Name="ImvuSplashSpin" />
                    </UIElement.RenderTransform>
                  </Ellipse>
                </Grid>
                <TextBlock x:Name="ImvuSplashTitle" Text="Loading IMVU…" Foreground="#C8D0FF" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,0" HorizontalAlignment="Center" />
                <TextBlock x:Name="ImvuSplashHint" Text="Letting the page start on its own" Foreground="#6A6A88" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
