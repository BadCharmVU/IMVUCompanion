                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="RoomUserMessageTitle" Text="Message to" FontSize="14" FontWeight="SemiBold" Foreground="#E8E8FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                      <ComboBox x:Name="RoomUserMessageModeCombo" Grid.Column="1" Height="26" MinWidth="132" Margin="10,0,0,0" VerticalAlignment="Center" SelectionChanged="RoomUserMessageMode_Changed">
                        <ComboBoxItem Content="Public" Tag="public" IsSelected="True" />
                        <ComboBoxItem Content="Whisper" Tag="whisper" />
                        <ComboBoxItem Content="Direct (DM)" Tag="dm" Foreground="#6A6A88"/>
                      </ComboBox>
                    </Grid>
                    <Grid x:Name="RoomUserMessageComposePanel" Margin="0,0,0,4">
                      <TextBox x:Name="RoomUserMessageBox" Style="{StaticResource GrowingReplyTextBox}" Padding="3,0,26,0" Background="#0F0F1C" Foreground="#E0E0FF" BorderBrush="#3A3A58" PreviewMouseWheel="NestedControl_PreviewMouseWheel" TextChanged="RoomUserMessageBox_TextChanged" />
                      <Button x:Name="RoomUserMessageClearBtn" Style="{StaticResource IconSquareButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" Panel.ZIndex="1" Visibility="Collapsed" ToolTip="Clear" Click="MessageEditClear_Click">
                        <Path Data="M1,1 L9,9 M9,1 L1,9" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                      </Button>
                    </Grid>
                    
                    <Grid x:Name="RoomUserMessagePrefixRow" Margin="0,0,0,10" MinHeight="22">
                      <CheckBox x:Name="RoomUserMessagePrefixCheck" Style="{StaticResource CompanionCheckBox}" Content="Prefix userName" HorizontalAlignment="Left" VerticalAlignment="Center" IsChecked="True" Checked="RoomUserMessagePrefix_Changed" Unchecked="RoomUserMessagePrefix_Changed" />
                      <TextBlock x:Name="RoomUserMessageCount" Text="0/1024" FontSize="10" Foreground="#8080A8" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Hidden" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <Button x:Name="RoomUserMessageCancelBtn" Content="Cancel" Width="118" Height="28" Margin="0,0,8,0" Style="{StaticResource Win11Button}" Click="RoomUserMessageCancel_Click" />
                      <Button x:Name="RoomUserMessageSendBtn" Content="Send Public" Width="118" Height="28" Style="{StaticResource Win11Button}" Click="RoomUserMessageSend_Click" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Border>
            </Grid>
          </Expander>
          <Expander x:Name="AiSettingsExpander" Style="{StaticResource DisabledSectionExpander}" IsExpanded="False" Margin="0,0,0,6" Expanded="DisabledAiSection_Expanded">
            <HeaderedContentControl.Header>
              <TextBlock Text="AI Settings" Foreground="#454545" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTip}" Text="Give me a short name and I will only respond to messages starting with it:" />
              <Border Style="{StaticResource SectionContentBox}">
                <StackPanel>
                  <TextBlock Text="AI name / trigger" FontSize="10" Foreground="#A0A0C8" Margin="0,0,0,4" />
                  <TextBox x:Name="CompanionAiTriggerBox" Height="28" Margin="0,0,0,8" Background="#0F0F1C" Foreground="#E0E0FF" BorderBrush="#3A3A58" FontSize="11" ToolTip="e.g. @MyBot or !ai — paid built-in AI (separate from AI Providers)" PreviewMouseWheel="NestedControl_PreviewMouseWheel" LostFocus="CompanionAiTriggerBox_LostFocus" />
                  <TextBlock Text="Built-in paid feature (your model). Different from AI Providers below." FontSize="10" Foreground="#606080" TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Expander>
          <Expander x:Name="AiProvidersExpander" Style="{StaticResource DisabledSectionExpander}" IsExpanded="False" Margin="0,0,0,6" Expanded="DisabledAiSection_Expanded">
            <HeaderedContentControl.Header>
              <TextBlock Text="AI Providers" Foreground="#454545" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
            </HeaderedContentControl.Header>
            <StackPanel>
              <TextBlock Style="{StaticResource SectionTip}" Text="Connect external APIs for !bbot. Separate from built-in AI Settings above." />
              <Border Style="{StaticResource SectionContentBox}">
                <StackPanel>
                  <TextBlock Text="Bot Display Name (your IMVU chat name — prevents echo loops):" FontSize="10" Foreground="#A0A0C8" Margin="0,0,0,4" />
                  <TextBox x:Name="BotDisplayNameBox" Height="28" Margin="0,0,0,8" Background="#0F0F1C" Foreground="#E0E0FF" BorderBrush="#3A3A58" FontSize="11" ToolTip="Must match your IMVU name shown in chat (.cs2-name)" PreviewMouseWheel="NestedControl_PreviewMouseWheel" LostFocus="BotDisplayNameBox_LostFocus" />
                  <WrapPanel Margin="0,0,0,6">
                    <ComboBox x:Name="AiProviderCombo" Style="{StaticResource Win11ComboBoxButton}" Width="130" Height="28" SelectionChanged="AiProviderCombo_SelectionChanged" />
                    <Button Content="Save" Margin="8,0,0,0" Height="28" Click="SaveAiSettings_Click" />
                  </WrapPanel>
                  <StackPanel x:Name="AiProviderFieldsPanel" Margin="0,2,0,0" />
                  <TextBlock x:Name="AiProviderStatusText" FontSize="10" Foreground="#707090" TextWrapping="Wrap" Margin="0,4,0,0" />
                  <TextBlock Text="!bbot triggers AI (maintenance reply until connected). Case-insensitive." FontSize="10" Foreground="#707090" Margin="0,4,0,0" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#2A2A45" ResizeDirection="Rows" ShowsPreview="True" />
      <DockPanel Grid.Row="3" LastChildFill="True" Margin="0,0,0,2">
        <TextBlock DockPanel.Dock="Top" Text="Activity Log" Foreground="#8080A8" FontSize="9" Margin="0,0,0,2" />
        <Border Background="#141428" CornerRadius="4" BorderBrush="#2A2A45" BorderThickness="1">
          <RichTextBox x:Name="LogBox" IsReadOnly="True" FontFamily="Consolas" FontSize="10" Background="#00FFFFFF" BorderThickness="0" Foreground="#C0C0E0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" />
        </Border>
      </DockPanel>
      <Grid Grid.Row="4">
        <TextBlock x:Name="StatsModeLabel" Text="SESSION:" FontSize="10" Cursor="Hand"
                   Foreground="#C0C0E0" HorizontalAlignment="Left" VerticalAlignment="Center"
                   Margin="6,0,0,0" TextWrapping="NoWrap"
                   MouseLeftButtonUp="StatsModeLabel_Click"/>
        <TextBlock x:Name="AliveText" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                   TextAlignment="Center" Margin="0" Padding="0" TextWrapping="NoWrap"/>
      </Grid>
    </Grid>
  </Grid>
</Window>