              <Button Content="Chat" Style="{StaticResource Win11ButtonSmall}" Margin="0,0,4,0" Click="NavChat_Click" />
              <Button Content="Reload" Style="{StaticResource Win11ButtonSmall}" Click="NavReload_Click" />
            </StackPanel>
          </DockPanel>
        </Border>
        <TextBlock DockPanel.Dock="Top" Text="Log in and open your chat room here, then Start →" Foreground="#606080" FontSize="9" Margin="2,0,0,4" />
